# Compixor AI Document Reconstruction Environment Configuration
# Development Port: Strictly 8003 (Port 8002 is reserved for production)
DEV_PORT=8003
HOST=0.0.0.0

# Vision-LLM API Key for Nastaliq Urdu transcription (Gemini or Claude)
VISION_API_KEY=your_api_key_here
VISION_PROVIDER=gemini

# CORS and Security
ALLOWED_ORIGINS=https://compixor-ai.cloud,https://www.compixor-ai.cloud,https://compixor-ai.vercel.app,http://localhost:3000

# File Upload Limits
MAX_UPLOAD_MB=10
