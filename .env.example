# ==============================================================================
# Compixor AI - Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local and fill in the values for local development.
# Never commit real credentials or .env.local to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Security & Administrative Auth
# ------------------------------------------------------------------------------
# Master password used to access the /admin/feedback moderation dashboard.
# CRITICAL: Must be set in production; fallback defaults are strictly blocked.
ADMIN_PASSWORD=your_strong_admin_password_here

# Cryptographic salt for anonymizing client IP addresses before storage.
FEEDBACK_SALT=your_random_feedback_hash_salt_here
IP_HASH_SALT=your_random_ip_hash_salt_here

# ------------------------------------------------------------------------------
# Backend Service Endpoints
# ------------------------------------------------------------------------------
# Official production backend API URL (FastAPI / Neural Matting & OCR engine)
NEXT_PUBLIC_API_URL=https://api.compixor-ai.cloud

# Optional backend endpoint overrides (defaults fallback to NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_BG_API_URL=https://api.compixor-ai.cloud
NEXT_PUBLIC_BG_REMOVE_API_URL=https://api.compixor-ai.cloud/remove-bg?bg=transparent
NEXT_PUBLIC_IMG2WORD_API_URL=https://api.compixor-ai.cloud/api/img-to-word

# ------------------------------------------------------------------------------
# Supabase Database (Feedback & Analytics)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
